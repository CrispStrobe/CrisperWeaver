# Standard Flutter iOS Podfile.
# CrisperWeaver loads libcrispasr/libwhisper via Dart FFI, not CocoaPods,
# so only Flutter plugin pods land here — no custom pod '...' lines.

platform :ios, '15.0'
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# Share Extension — intentionally no pod dependencies. We vendor
# RSIShareViewController + its supporting types directly in
# ios/ShareExtension/RSIShareViewController.swift to keep the
# extension framework-free. See that file's header for why; tl;dr:
# the upstream receive_sharing_intent pod calls
# FlutterPluginRegistrar.addApplicationDelegate which is marked
# unavailable in app extensions, so linking the framework into a
# strict extension target fails. The main Runner target keeps the
# pod normally via flutter_install_all_ios_pods above.
target 'ShareExtension' do
  use_frameworks!
  use_modular_headers!
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # CrispEmbed's iOS podspec requires a 15.0 minimum; keep the app and
      # all plugin pods aligned so `pod install` resolves (fixes v0.7.6 iOS).
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      # CrispASR's C++ code uses C++17.
      config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      config.build_settings['CLANG_CXX_LIBRARY'] = 'libc++'
    end
  end
end
