	<!-- Status Bar -->
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Privacy and Permissions -->
	<key>NSMicrophoneUsageDescription</key>
	<string>This app needs access to the microphone to record audio for transcription.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>This app needs access to documents to save and load audio files and transcriptions.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>This app needs access to downloads to import audio files for transcription.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs access to photo library to import media files for transcription.</string>

	<!-- Required by Flutter for wireless debugging on iOS 14+. The
	     Dart VM service binds to a local port and is discovered by
	     `flutter run` over Bonjour. Without these two keys iOS
	     silently blocks the VM service handshake, the debug build
	     never finishes initialising, and the app stays on the
	     white LaunchScreen forever. Release / AOT builds don't
	     need this (no VM service), but it's harmless to ship in
	     all configs. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Allow CrisperWeaver to connect to its development host on the same Wi-Fi for hot-reload and debugging.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_dartVmService._tcp</string>
	</array>

	<!-- Background Modes -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>background-processing</string>
		<string>background-fetch</string>
	</array>

	<!-- Audio Session -->
	<key>UIRequiresPersistentWiFi</key>
