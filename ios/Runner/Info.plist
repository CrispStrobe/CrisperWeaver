				<string>public.content</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>crisperweaver</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/x-crisperweaver-transcription</string>
				</array>
			</dict>
		</dict>
		<dict>
