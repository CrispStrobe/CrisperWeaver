	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>huggingface.co</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
			<key>cdn-lfs.huggingface.co</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<false/>
				<key>NSExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>

	<!-- CoreML and Metal Support -->
	<key>com.apple.developer.coreml</key>
	<true/>
	<key>MetalPerformanceShadersGraph</key>
	<true/>

	<!-- App Capabilities -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<!--
	No UIApplicationSceneManifest: the standard Flutter iOS template uses
	the AppDelegate-only single-window architecture. The previous manifest
	referenced $(PRODUCT_MODULE_NAME).SceneDelegate, but no SceneDelegate
	class exists in this target — iOS would log a connection failure on
	launch on every iOS 13+ device. Add a real SceneDelegate.swift before
	re-introducing the manifest.
	-->

	<!-- App icon: asset-catalog only (modern iOS 11+ setup). Do NOT add
	     CFBundleIcons/CFBundleIcons~ipad with CFBundleIconFiles — listing
	     Icon-App-1024x1024 there is invalid (the 1024 marketing icon must
	     live only in the AppIcon asset catalog), which produced loose
	     low-res icons + blank placeholders, made App Store Connect extract
	     a 167px iPad icon (no store icon), and hard-rejected the build in
	     processing. The AppIcon.appiconset carries the real 1024² icon. -->
	<key>CFBundleIconName</key>
	<string>AppIcon</string>

	<!-- QuickLook Support -->
	<key>QLSupportedContentTypes</key>
	<array>
		<string>public.audio</string>
		<string>public.plain-text</string>
		<string>com.crispstrobe.crisperweaver.transcription</string>
	</array>

	<!-- Spotlight Search -->
	<key>CoreSpotlightContinuation</key>
	<true/>

	<!-- Handoff -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>com.crispstrobe.crisperweaver.transcription</string>
		<string>com.crispstrobe.crisperweaver.recording</string>
	</array>

	<!--
	Privacy manifest lives in PrivacyInfo.xcprivacy (separate file, in the
	Runner target's resources). NSPrivacy* keys in Info.plist are ignored
	by Apple's tooling; declaring them here used to look like the manifest
	was present when it wasn't. Removed.

	Also removed three other dead Info.plist keys:
	- UIAccessibilityEnabled (not a real Info.plist key)
	- UIApplicationExitsOnSuspend (deprecated since iOS 13, ignored)
	- UIPrerenderedIcon (deprecated since iOS 11, ignored)
	-->


	<!-- CarPlay Support (optional) -->
	<!--
	NOTE: NSExtension belongs in an extension target's Info.plist, not the
	host app's. Removed an `NSExtensionPointIdentifier =
	com.apple.widgetkit-extension` block here that would have caused iOS to
	treat the main bundle as an extension. If we ship a real WidgetKit
	extension later it gets its own target with its own Info.plist.
	-->

	<key>UIApplicationSupportsCarPlay</key>
	<false/>

	<!-- Apple Pencil Support -->
	<key>UIPencilPreferredAction</key>
	<integer>1</integer>

	<!-- Keyboard Support -->
	<key>UIKeyboardDismissMode</key>
	<string>onDrag</string>

	<!-- 3D Touch -->
	<key>UIForceTouchCapability</key>
	<true/>

	<!-- App Store Information -->
