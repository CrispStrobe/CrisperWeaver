<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Identity -->
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>CrisperWeaver</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>crisper_weaver</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- iOS Version Requirements -->
	<key>MinimumOSVersion</key>
	<string>13.0</string>
	<key>DTPlatformName</key>
	<string>iphoneos</string>

	<!-- Device Capabilities -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>microphone</string>
	</array>

	<!-- Interface and Orientation -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>

	<!-- Status Bar -->
	<key>UIStatusBarHidden</key>
	<false/>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Privacy and Permissions -->
	<key>NSMicrophoneUsageDescription</key>
	<string>This app needs access to the microphone to record audio for transcription.</string>
	<key>NSDocumentsFolderUsageDescription</key>
	<string>This app needs access to documents to save and load audio files and transcriptions.</string>
	<key>NSDownloadsFolderUsageDescription</key>
	<string>This app needs access to downloads to import audio files for transcription.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>This app needs access to photo library to import media files for transcription.</string>

	<!-- Two consumers, and the string has to describe the one a USER can
	     trigger, not the one a developer can.

	     1. Release: starting the optional OpenAI-compatible API server
	        (Settings → Advanced → Server) binds a listening socket, and
	        iOS raises the local-network prompt the moment it does.
	     2. Debug only: the Dart VM service binds a local port discovered
	        by `flutter run` over Bonjour (hence NSBonjourServices below).
	        Without the key the debug handshake is blocked silently and the
	        app hangs on the white LaunchScreen.

	     This string used to describe (2) alone — "connect to its
	     development host … for hot-reload and debugging" — which is text no
	     shipping user can act on and which does not explain the access they
	     are actually being asked to grant. Guideline 5.1.1 wants the
	     purpose string to make sense to the person reading the alert. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>CrisperWeaver needs this only if you turn on its built-in transcription server, so other apps can send it audio. The server is off by default and accepts connections from this device unless you change its address.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_dartVmService._tcp</string>
	</array>

	<!-- Background Modes -->
	<!-- Only `audio` is a valid UIBackgroundModes value we actually use
	     (background TTS playback / recording). The prior entries
	     'background-processing' / 'background-fetch' are Xcode capability
	     *labels*, not valid plist values (the real values are 'processing' /
	     'fetch') — App Store upload rejects them (ITMS-90112), and the app
	     ships no BGTaskScheduler / background-fetch code, so they're dropped. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<!-- Audio Session -->
	<key>UIRequiresPersistentWiFi</key>
	<false/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>

	<!-- File Type Associations -->
	<key>CFBundleDocumentTypes</key>
