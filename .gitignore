# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Per-developer paths and Flutter-generated glue that must not be committed.
android/local.properties
android/.gradle/
android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java
ios/Flutter/Generated.xcconfig
ios/Flutter/flutter_export_environment.sh
ios/Flutter/ephemeral/
ios/Runner/GeneratedPluginRegistrant.h
ios/Runner/GeneratedPluginRegistrant.m
ios/Pods/
ios/Podfile.lock
macos/Flutter/Generated.xcconfig
macos/Flutter/ephemeral/
macos/Flutter/flutter_export_environment.sh
macos/Flutter/GeneratedPluginRegistrant.swift
macos/Pods/
macos/Podfile.lock
linux/flutter/ephemeral/
windows/flutter/ephemeral/

# Claude / IDE session state
.claude/

# Prebuilt native libraries are produced by building CrispASR and are too
# large / platform-specific to live in git. See README "Android / iOS".
android/app/src/main/jniLibs/**/*.so
ios/Runner/Frameworks/*.xcframework
ios/build/
macos/Runner/Frameworks/libwhisper.dylib
/handover-prompts/

# The placeholder espeak-ng-data.tar.gz is committed so flutter pub
# get / desktop builds don't fail asset resolution; the real
# multi-MB build artefact is created by the Android CI job and
# never round-trips back to git.

# Local-only scratch notes for Claude (env-specific; not shared)
CLAUDE.md
.vercel
